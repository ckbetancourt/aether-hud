# Copy to .env.local — if both .env and .env.local exist, .env.local wins.

# Backend: Hermes is the default. Use openai only for explicit fallback testing.
AETHER_BACKEND=hermes

# Hermes API (requires "hermes gateway" — see hermes/README.md)
HERMES_API_BASE_URL=http://127.0.0.1:8642/v1
# Same secret as API_SERVER_KEY in ~/.hermes/.env
HERMES_API_KEY=change-me-local-dev

# Optional overrides
# HERMES_MODEL=hermes-agent
# HERMES_PROFILE=

# Optional capability URLs if your Hermes build exposes list endpoints
# HERMES_PROFILES_URL=
# HERMES_SESSIONS_URL=
# Hermes web dashboard base URL (session restore on reload + Kanban board mode; default port 9119)
# HERMES_DASHBOARD_URL=http://127.0.0.1:9119

AETHER_TEMPERATURE=0.7
PORT=8787

# Local SQLite file for HUD settings and archives (default: ./data/aether.db)
# AETHER_DATA_DIR=./data

# Optional ElevenLabs TTS (https://elevenlabs.io)
# HUD: Settings → Speech engine → ElevenLabs. Restart npm start after changing these.
# ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# ELEVENLABS_DEFAULT_VOICE_ID=

# Optional OmniVoice local TTS (https://github.com/k2-fsa/OmniVoice + OmniVoice-local server)
# HUD: Settings → Speech engine → OmniVoice (local). Restart npm start after changing these.
# OMNIVOICE_BASE_URL=http://127.0.0.1:8000
# OMNIVOICE_API_KEY=
# OMNIVOICE_DEFAULT_SAMPLE=
# OMNIVOICE_DEFAULT_INSTRUCT=

# TTS replay ring buffer size (HUD setting aether_tts_replay_cache_size overrides; default 5, max 20)
# Stored in data/tts-replay/ alongside data/aether.db

# OpenAI-compatible fallback (AETHER_BACKEND=openai)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
