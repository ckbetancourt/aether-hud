# Copy to .env and/or .env.local — if both exist, .env.local overrides (good for LM Studio).
# OpenAI-compatible API (OpenAI, OpenRouter, Groq, local Ollama, LM Studio, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=qwen/qwen3.6-35b-a3b

# Server
PORT=8787

# TTS uses the browser speechSynthesis API (Chrome/Edge recommended).

# Examples:
# Local Ollama:
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_MODEL=llama3.2
# OPENAI_API_KEY can be left empty for Ollama
