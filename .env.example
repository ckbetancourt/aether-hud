# Copy to .env and/or .env.local — if both exist, .env.local overrides.

# Backend mode: Hermes is the default runtime. Set openai only for explicit fallback testing.
AETHER_BACKEND=hermes

# Hermes Agent bridge — usually only the base URL is needed (default: http://127.0.0.1:8000/v1)
HERMES_API_BASE_URL=http://127.0.0.1:8000/v1

# Optional overrides (Hermes owns model, auth, and profiles by default)
# HERMES_MODEL=          # only if your Hermes API requires a specific model id
# HERMES_API_KEY=        # only if the Hermes API server requires bearer auth
# HERMES_PROFILE=        # server-wide default; otherwise use the HUD profile picker

# Optional generation temperature for the bridge
AETHER_TEMPERATURE=0.7

# Optional capability endpoints if your Hermes build exposes them.
HERMES_PROFILES_URL=
HERMES_SESSIONS_URL=

# Explicit fallback only: generic OpenAI-compatible API.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=qwen/qwen3.6-35b-a3b

# Server
PORT=8787

# TTS uses the browser speechSynthesis API (Chrome/Edge recommended).

# Explicit fallback examples:
# Local Ollama through AETHER_BACKEND=openai:
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_MODEL=llama3.2
# OPENAI_API_KEY can be left empty for Ollama
